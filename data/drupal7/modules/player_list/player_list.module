/**
 * Implements hook_permission().
 *
 */
function player_list_permission() {
  return array(
    'rating list' => array(
      'title' => t('player list'),
      'description' => t('Administer Player list module'),
    ),
  );
}

/**
 * Implementation of hook_menu().
 */
function player_list_menu() {
  
  // Admin menu options

  $items['admin/structure/player_list'] = array(
    'title' => 'League Players',
    'description' => 'Manage Players',
    'page callback' => 'player_list_overview_types',
    'access arguments' => array('player list'),
  );

  $items['admin/structure/player_list/manage'] = array(
    'title' => 'Manage Player Entity',
    'description' => 'Manage Players',
    'page callback' => 'player_list_information',
    'access arguments' => array('player list'),
  );
  $items['admin/structure/player_list/manage/player_list/view'] = array(
    'title' => 'View',
    'type' => MENU_DEFAULT_LOCAL_TASK,
  );

  // List player lists for an org
  $items['player_list/plists/%'] = array(
    'title' => 'Player Lists',
    'page callback' => 'player_lists_org',
    'page arguments' => array(2),
    'access callback' => TRUE,
    'access arguments' => array(1,'organisation'),
    'type' => MENU_LOCAL_TASK,
    'weight' => -12,
  );

  $items['player_list/add'] = array(
    'title' => 'Add Player',
    'page callback' => 'player_list_add_to_org',
    'page arguments' => array(2),
    'access callback' => 'player_list_org_permission',
    'access arguments' => array(2),
    'file' => 'player_list_update.inc',
  );

  // Note: the player_list/%player_list menu spec causes function
  // player_list_load to be called passing %player_list as an arg.
  // whatever player_list_load returns is then passed into 
  // the page callback player_list_view_page
  $items['player_list/%player_list'] = array(
    'title' => 'View Player',
    'title callback' => 'player_list_view_title',
    'title arguments' => array(1),
    'page callback' => 'player_list_view_page',
    'page arguments' => array(1),
    'access callback' => TRUE,
    'file' => 'player_list_view.inc',
    'type' => MENU_CALLBACK,
  );
  $items['player_list/%player_list/view'] = array(
    'title' => 'View',
    'type' => MENU_DEFAULT_LOCAL_TASK,
    'weight' => -10,
  );
  $items['player_list/%player_list/edit'] = array(
    'title' => 'Edit',
    'page callback' => 'player_list_edit_page',
    'page arguments' => array(1),
    'file' => 'player_list_update.inc',
    'access callback' => 'player_list_check_permission',
    'access arguments' => array(1,'3'),
    'type' => MENU_LOCAL_TASK,
    'weight' => 0,
    'context' => MENU_CONTEXT_PAGE|MENU_CONTEXT_INLINE,
  );

  // Delete player from list
  $items['player_list/%/delete/%/%'] = array(
    'title' => 'Delete Player From List',
    'page callback' => 'player_list_delete_from_list',
    'page arguments' => array(1,3,4),
    'access callback' => TRUE,
    'file' => 'player_list_delete.inc',
  );

  // Delete player from org
  $items['player_list/%/delorg/%'] = array(
    'title' => 'Delete Player From List',
    'page callback' => 'player_list_delete_from_org',
    'page arguments' => array(1,3),
    'access callback' => TRUE,
    'file' => 'player_list_delete.inc',
  );

  $items['player_list_list/add'] = array(
    'title' => 'Add Player List',
    'page callback' => 'player_list_list_add_to_org',
    'page arguments' => array(2),
    'access callback' => 'player_list_org_permission',
    'access arguments' => array(2),
    'file' => 'player_list_list_update.inc',
  );

  $items['player_list_list/%player_list_list'] = array(
    'title' => 'View Player List',
    'title callback' => 'player_list_list_view_title',
    'title arguments' => array(1),
    'page callback' => 'player_list_list_view_page',
    'page arguments' => array(1),
    'access callback' => TRUE,
    'file' => 'player_list_list_view.inc',
    'type' => MENU_CALLBACK,
  );

  $items['player_list_list/%player_list_list/view'] = array(
    'title' => 'View',
    'type' => MENU_DEFAULT_LOCAL_TASK,
    'weight' => -10,
  );

  $items['player_list_list/%player_list_list/admin'] = array(
    'title' => 'Admin',
    'page callback' => 'player_list_list_edit_page',
    'page arguments' => array(1),
    'file' => 'player_list_list_update.inc',
    'access callback' => 'player_list_check_permission',
    'access arguments' => array(1),
    'type' => MENU_LOCAL_TASK,
    'weight' => 0,
    'context' => MENU_CONTEXT_PAGE|MENU_CONTEXT_INLINE,
  );

  $items['player_list_list/%player_list_list/addp'] = array(
    'title' => 'Add New Player',
    'page callback' => 'player_list_list_addp_page',
    'page arguments' => array(1),
    'file' => 'player_list_update.inc',
    'access callback' => 'player_list_check_permission',
    'access arguments' => array(1),
    'type' => MENU_LOCAL_TASK,
    'weight' => 0,
    'context' => MENU_CONTEXT_PAGE|MENU_CONTEXT_INLINE,
  );

  // Delete player list
  $items['player_list_list/%player_list_list/delete'] = array(
    'title' => 'Delete Player List',
    'page callback' => 'player_list_delete_list_option',
    'page arguments' => array(1,3),
    'access callback' => TRUE,
    'file' => 'player_list_list_delete.inc',
  );

  $items['player_list/addto'] = array(
    'title' => 'Add player to list',
    'page callback' => 'player_list_add_to_list_page',
    'access callback' => TRUE,
    'file' => 'player_list_update.inc',
  );

  // Option to lookup user id for a player
  $items['player_list/%ctools_js/looku/%'] = array(
    'title' => 'Hello World',
    'page callback' => 'player_list_lookup_user',
    'page arguments' => array(1,3),
    'file' => 'player_list_lookup_user.inc',
    'access callback' => TRUE,
    'type' => MENU_CALLBACK,
  );

  // When a player gets picked from the user lookup
  $items['player_list/%ctools_js/lookup/%player_list/%user'] = array(
      'title' => 'Hello World',
      'page callback' => 'player_list_select_user',
      'page arguments' => array(1, 3, 4),
      'access callback' => TRUE,
      'type' => MENU_CALLBACK,
  );

  return $items;
}

/**
 * implementation of hook_entity_info().
 */
