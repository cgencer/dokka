<?php
/**
 * @file
 * Players and lists for League module.
 */

function player_list_overview_types() {
  $content = l("Manage League Player entity fields", 'admin/structure/player_list/manage');
  return $content;
}

function player_list_information() {
  $content = 'Manager fields in the League Player entity';
  return $content;
}

